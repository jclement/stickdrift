{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stickdrift",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // StickDrift (Straybits Corp) at the apex of stickdrift.net; wrangler
  // provisions the DNS record and certificate.
  "routes": [{ "pattern": "stickdrift.net", "custom_domain": true }],
  // Built by Vite into dist/client. The Worker runs first for the API, the
  // WebSocket endpoints and the page routes; everything else is a static file.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/j", "/j/*", "/demo"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Session" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  "observability": { "enabled": true },
  // Overridden at deploy time with the git build id (mise run deploy).
  "vars": { "BUILD": "dev" }
}
